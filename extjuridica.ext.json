                                        "Pecuario",
                                        "Recreacional",
                                        "Religioso",
                                        "Salubridad",
                                        "Servicios_Funerarios",
                                        "Servicios_Sociales",
                                        "Uso_Publico"
                                    ]
                                },
                                "Avaluo": {
                                    "description": "Estructura que contiene el avalúo del predio en la base de datos catastral",
                                    "type": "array",
                                    "minItems": 1,
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "Fecha_Avaluo": {
                                                "description": "Fecha de la realización del avalúo catastral",
                                                "type": "string",
                                                "format": "date"
                                            },
                                            "Valor_Comercial": {
                                                "description": "Precio más probable por el cual un predio se transaría en un mercado en donde el comprador y el vendedor actuarían libremente con el conocimiento de las condiciones físicas y jurídicas que afectan el bien, el cual debe contar con soporte económico acorde con la teoría de valor y su único fin es la determinación de los avalúos catastrales por parte de los gestores catastrales",
                                                "type": "number"
                                            },
                                            "Avaluo_Catastral": {
                                                "description": "Valor de un predio resultante de un ejercicio técnico en desarrollo de los procesos catastrales, que en ningún caso podrá ser inferior al 60% del valor comercial o superar el valor de este último",
                                                "type": "number"
                                            },
                                            "Valor_Comercial_Terreno": {
                                                "description": "Valor más probable por el cual se transaría el terreno en el mercado",
                                                "type": "number"
                                            },
                                            "Avaluo_Catastral_Terreno": {
                                                "description": "Avalúo catastral del terreno",
                                                "type": "number"
                                            },
                                            "Valor_Comercial_Total_UnidadesConstruccion": {
                                                "description": "Valor más probable por el cual se transarían las unidades constructivas en el mercado",
                                                "type": "number"
                                            },
                                            "Avaluo_Catastral_Total_UnidadesConstruccion": {
                                                "description": "Avalúo catastral de las unidades de construcción",
                                                "type": "number"
                                            },
                                            "Autoestimacion": {
                                                "description": "Derecho que tiene todo interesado de presentar antes del 30 de junio de cada año ante el correspondiente gestor catastral, la Secretaría de Hacienda municipal, distrital y/o quien haga sus veces, la estimación del avalúo catastral de su inmueble",
                                                "type": "boolean"
                                            },
                                            "Incremento": {
                                                "description": "Se deberá indicar si el predio tuvo aplicación de lo dispuesto en el artículo 49 de la ley 2294 del 2023 por el cual se expide el plan nacional de desarrollo 2022-2026 Colombia potencia mundial de la vida",
                                                "type": "boolean"
                                            }
                                        },
                                        "required": [
                                            "Fecha_Avaluo",
                                            "Avaluo_Catastral",
                                            "Autoestimacion"
                                        ]
                                    }
