                                        "Parque_Cementerio_Unidad_Predial",
                                        "Via",
                                        "Informal",
                                        "Bien_Uso_Publico"
                                    ]
                                },
                                "Destinacion_Economica": {
                                    "description": "Clasificación que se da a cada inmueble en su conjunto -terreno y unidades de construcción-, en el momento de la identificación predial de conformidad con la actividad predominante que en él se desarrolle.",
                                    "type": "string",
                                    "enum": [
                                        "Acuicola",
                                        "Agricola",
                                        "Agroindustrial",
                                        "Agroforestal",
