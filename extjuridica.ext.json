                                        "required": [
                                            "Numero_Predial_Nacional",
                                            "Area_Catastral_Terreno"
                                        ]
                                    }
                                },
                                "Fecha_Inscripcion_Catastral": {
                                    "description": "Fecha de registro de los ingresos, modificaciones o cancelaciones en la base de datos catastral, de acuerdo con lo señalado en el título IV de la Resolución 1040 de 2023.",
                                    "type": "string",
                                    "format": "date"
                                },
                                "Tipo_Predio": {
                                    "description": "Valores para indicar los tipos de predios",
                                    "type": "string",
                                    "enum": [
                                        "Predio",
