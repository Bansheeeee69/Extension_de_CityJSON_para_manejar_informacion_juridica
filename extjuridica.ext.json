                                        "Fiscal_Patrimonial",
                                        "Uso_Publico",
                                        "Presunto_Baldio",
                                        "Privado"
                                    ]
                                },
                                "Condicion_Predio": {
                                    "description": "Valores para indicar el tipo de condición de predio",
